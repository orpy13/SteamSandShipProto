; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Steam Sand Ship — Co-op Prototype"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.6")

[autoload]

GameState="*res://scripts/autoloads/game_state.gd"
NetworkManager="*res://scripts/network_manager.gd"
AudioManager="*res://scripts/autoloads/audio_manager.gd"
Regions="*res://scripts/autoloads/regions.gd"
POIRegistry="*res://scripts/autoloads/poi_registry.gd"
ChartState="*res://scripts/autoloads/chart_state.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

[editor_plugins]

enabled=PackedStringArray("res://addons/chunk_editor/plugin.cfg")

[file_customization]

folder_colors={
"res://assets/": "orange"
}

